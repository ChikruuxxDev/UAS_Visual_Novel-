    },
    "Scene 4": {
        "Type" : "Dialogue",
        "BG" : "Kota_Mati_(Siang)",
        "Text" : [
            {"Char": "", "CharEx":0, "Text": "Seperti terbangun dari mimpi panjang, aku membuka mataku dan melihat hamparan warna biru. Melihat sekelilingku, sepertinya diriku terbangun di tengah kota.", "BGM": "", "SFX": "", "Pos": ""},
            {"Char": "", "CharEx":0, "Text": "Namun, aku tidak melihat bahkan mendengar orang-orang. Aku terus berjalan, menuju pusat perbelanjaan, taman kota, restoran, bahkan tempat administrasi sekalipun.", "BGM": "", "SFX": "", "Pos": ""},
            {"Char": "", "CharEx":0, "Text": "Layaknya kota mati, kemanapun aku berjalan, aku tak menemukan siapa-siapa.", "BGM": "", "SFX": "", "Pos": ""}
        ],
        "Next" : "Scene 5"
    },
        "Scene 5": {
        "Type" : "Dialogue",
        "BG" : "Kota_Mati_(Siang)",
        "Text" : [
            {"Char": "", "CharEx":0, "Text": "Tanpa kusadari, waktupun berlalu. Saat ingin mengistirahatkan mataku terdengar sebuah ledakan dari arah aku berjalan sebelumnya. Aku menelusuri jejakku sebelumnya dan mengikuti asal suara ledakan.", "BGM": "", "SFX": "", "Pos": ""},
            {"Char": "", "CharEx":0, "Text": "*Duar", "BGM": "", "SFX": "ledakan", "Pos": ""}
        ],
        "Next" : "Scene 6"
    },
    "Scene 6": {
        "Type" : "Dialogue",
        "BG" : "Pusat_perbelanjaan_hancur",
        "Text" : [
            {"Char": "", "CharEx":0, "Text": "Pusat perbelanjaan yang kudatangi sebelumnya sudah rata dengan tanah. Dibalik puing-puing, suara raungan menggema di kota mati itu. Muncul monster yang mirip gajah bangkit dari puing-puing.", "BGM": "", "SFX": "", "Pos": ""},
            {"Char": "", "CharEx":0, "Text": "“Kenapa?”", "BGM": "", "SFX": "", "Pos": ""},
            {"Char": "", "CharEx":0, "Text": "Monster itu melihatku. Ia seperti mengambil ancang-ancang. Aku bergeming melihatnya.", "BGM": "", "SFX": "", "Pos": ""},
            {"Char": "Varsya", "CharEx":4, "Text": "“Hei, kau bodoh apa tolol?”", "BGM": "", "SFX": "ledakan", "Pos": "Center"}
        ],
        "Next" : "Scene 7"
    },
    "Scene 7": {
        "Type" : "Dialogue",
