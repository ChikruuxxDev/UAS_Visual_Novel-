{
    "Scene 1": {
        "Type" : "Dialogue",
        "BG" : "Hitam",
        "Text" : [
            {"Char": "", "CharEx": 2, "Text": "Aku pernah bermimpi, menuju jalan yang tak pasti. Bisikan orang-orang menggema di kepalaku. Kupikir aku sudah berusaha, sudah membuktikan, sudah berjuang.", "BGM": "", "SFX": "", "Pos": ""},
            {"Char": "", "CharEx":0, "Text": "Tapi, apakah orang lain menganggapnya begitu? Aku sudah terlalu lelah untuk memikirkan itu.", "BGM": "", "SFX": "", "Pos": ""}
        ],
        "Next" : "Scene 2"
    },
    "Scene 2": {
        "Type" : "Dialogue",
        "BG" : "Putih",
        "Text" : [
            {"Char": "", "CharEx":0, "Text": "Apakah ini akhirnya?", "BGM": "", "SFX": "", "Pos": ""}
        ],
        "Next" : "Scene 3"
    },
    "Scene 3": {
        "Type" : "Video",
        "BG" : [
            {"BG": "sky_day", "Delay" : 3},
            {"BG": "Kota_Mati_(Siang)", "Delay" : 2}
        ],
